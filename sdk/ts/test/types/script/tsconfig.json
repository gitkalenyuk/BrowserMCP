{
  // Type-checks scripts for the script host against the generated
  // crates/script/types/browser.d.ts (globals `browser`, `inputs`, `sleep`).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Scripts are ES modules (top-level await) even without import/export.
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "files": ["../../../../../crates/script/types/browser.d.ts"],
  "include": ["sample.ts", "../../../../../scripts/examples/*.ts"]
}
